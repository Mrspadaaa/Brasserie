{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laffinee.invalid/schemas/sol-handoff-result.schema.json",
  "title": "L'Affinée Sol handoff result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "evidence", "openQuestions"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "needs_expert", "blocked"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "evidence": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "detail"],
        "properties": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "detail": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "properties": { "evidence": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["needs_expert", "blocked"] } }, "required": ["status"] },
      "then": { "properties": { "openQuestions": { "minItems": 1 } } }
    }
  ]
}
