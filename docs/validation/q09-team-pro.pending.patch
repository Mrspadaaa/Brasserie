+    // One strict validation of the incoming copy, one of the stored row read inside the transaction.
+    expect(count(STUDY)).toBe(2);
+    expect(count(PREPARATION_V1)).toBe(2);
+    expect(saved.revision).toBe(current.revision + 1);
+    expect(saved.qualifiedStudyPreparations).toEqual(current.qualifiedStudyPreparations);
