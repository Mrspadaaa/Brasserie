# Copier en `.env` (jamais committé) et remplir.

# --- Développement local ---
# Branche l'application sur les émulateurs Firebase au lieu de la production.
VITE_USE_FIREBASE_EMULATORS=false

# --- App Check ---
# Clé de site reCAPTCHA Enterprise, créée dans la console Google Cloud.
# Laisser vide désactive App Check (l'app fonctionne, les règles Firestore
# protègent déjà les données).
VITE_RECAPTCHA_SITE_KEY=

# Jeton de debug App Check, affiché dans la console du navigateur au premier
# lancement. À enregistrer ensuite dans Firebase Console > App Check > Apps.
VITE_APPCHECK_DEBUG_TOKEN=

# --- Firebase ---
# Console Firebase > Paramètres du projet > Vos applications > Configuration.
# Aucune de ces valeurs n'est un secret d'authentification, mais elles
# identifient le projet : elles restent hors du dépôt public.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Coordonnées de l'entreprise ---
# Repli quand `config.company` n'est pas renseigné dans les Réglages.
# ⚠️ Un IBAN ne se met JAMAIS dans un fichier source.
VITE_COMPANY_NAME=
VITE_COMPANY_OWNER=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_NPA=
VITE_COMPANY_UID=
VITE_COMPANY_IBAN=

# --- Comptes autorisés ---
# Adresses Google pouvant ouvrir l'application, séparées par des virgules.
# La vraie autorisation est appliquée par firestore.rules et les Cloud
# Functions : cette liste ne sert qu'à afficher un message clair.
VITE_AUTHORIZED_ACCOUNTS=
